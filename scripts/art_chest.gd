## Variants built from the sprites above (glowing / cracked egg).
static func variants() -> Dictionary:
	var egg: Array = SPRITES["strange_egg"]
	var glow: Array = []
	for r in egg:
		glow.append(String(r).replace("e", "k").replace("7", "b"))
	var cracked: Array = egg.duplicate()
	cracked[7] = "......7707.....".rpad(16, ".")
	cracked[8] = ".....7e70777....".rpad(16, ".")
	cracked[9] = ".....7770e77....".rpad(16, ".")
	cracked[10] = "....7e77077e7...".rpad(16, ".")
	cracked[11] = "....77708e777...".rpad(16, ".")
	return {"strange_egg_glow": glow, "strange_egg_cracked": cracked}
