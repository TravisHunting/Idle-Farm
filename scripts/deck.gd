		"needs": [["no_relic", "crow_crown"]],
		"text": "A crow in a tiny gold crown demands tribute. Its court watches from the trees.",
		"a": {"label": "Pay Tribute", "desc": "Pay 60. Receive the Crown: crows never raid again.", "req": [], "fx": [["coins", -60], ["relic", "crow_crown"], ["weird", 4]], "reply": "CAW. (Acceptable.)"},
		"b": {"label": "Refuse", "desc": "The whole court descends on the crops.", "req": [], "fx": [["spawn", "crow", 8]], "reply": "CAW!!"}},
	{"id": "wizard", "title": "Wandering Wizard", "art": "v_wizard", "rarity": 2, "level": 1, "weird": 0, "visitor": true,
		"text": "A wizard asks to borrow the farmer's hoe 'for science'.",
		"a": {"label": "Lend the Hoe", "desc": "It comes back enchanted: a checkerboard field tills itself.", "req": [], "fx": [["field", "checker", "mixed"], ["weird", 2]], "reply": "Most kind!"},
		"b": {"label": "Ask for a Spell", "desc": "Needs mood 60+. Green Thumb: crops grow 30% faster, forever.", "req": [["mood", 60], ["no_perk", "green_thumb"]], "fx": [["perk", "green_thumb"], ["weird", 3]], "reply": "Abraca-turnip!"}},
	{"id": "glowing_seeds", "title": "Glowing Seeds", "art": "crop_moonflower", "rarity": 2, "level": 1, "weird": 5,
		"needs": [["no_relic", "star_map"]],
		"text": "A packet of seeds that glow faintly in the dark. The label just says 'SOON'.",
		"a": {"label": "Plant at Night", "desc": "Must be night. A ring of Moonflowers (valuable), unlocked.", "req": [["night"]], "fx": [["unlock", "moonflower"], ["field", "ring", "moonflower"], ["weird", 4]]},
		"b": {"label": "Sell to a Collector", "desc": "+120 coins.", "req": [], "fx": [["coins", 120]]}},
	{"id": "harvest_fair", "title": "Harvest Fair", "art": "crop_pumpkin", "rarity": 2, "level": 2, "weird": 0,
		"text": "The county harvest fair! Ribbons, pies, and one suspicious goat judge.",
		"a": {"label": "Prize Pumpkin", "desc": "Takes 1 ripe pumpkin. Grand prize money!", "req": [], "fx": [["take_ripe", "pumpkin", 1], ["coins", 350], ["mood", 15]]},
		"b": {"label": "Pie Contest", "desc": "Takes 3 eggs. Second place pays well.", "req": [], "fx": [["item", "egg", -3], ["coins", 150]]}},
	{"id": "sun_cult", "title": "Sun Worshippers", "art": "v_cultist", "rarity": 2, "level": 1, "weird": 10, "visitor": true, "crowd": 3,
		"text": "Robed strangers admire the sunflowers. 'They face the sun,' one says. 'Do you?'",
		"a": {"label": "Join the Chant", "desc": "Needs 5 growing sunflowers. Sun & growth for 10 min. +8 weird.", "req": [["crop", "sunflower", 5]], "fx": [["weather", "sunny", 600], ["buff", "sun", 600], ["buff", "growth", 600], ["weird", 8], ["mood", 10]], "reply": "PRAISE THE BIG ONE."},
		"b": {"label": "Sell Them Seeds", "desc": "They plant a sunflower spiral 'for the sun'. +60 coins.", "req": [], "fx": [["coins", 60], ["field", "diagonal", "sunflower"]], "reply": "We will return."}},
	{"id": "insurance", "title": "Insurance Man", "art": "v_suit", "rarity": 2, "level": 1, "weird": 0, "visitor": true,
		"text": "A man in a damp grey suit sells 'catastrophe insurance'. His umbrella is open indoors.",
		"a": {"label": "Buy a Policy", "desc": "Pay 50. +4 Lucky Charms.", "req": [], "fx": [["coins", -50], ["charm", 4]], "reply": "You're covered. Mostly."},
		"b": {"label": "Slam the Door", "desc": "Satisfying. +15 mood. He'll tell the taxman.", "req": [], "fx": [["mood", 15], ["delay", 240, [["add_card", "taxman"]], "Someone is coming up the lane with a ledger."]], "reply": "You'll regret this."}},
	{"id": "taxman", "title": "The Taxman", "art": "v_suit", "rarity": 2, "level": 2, "weird": 0, "visitor": true,
		"text": "The county tax collector has arrived with a very large ledger.",
		"a": {"label": "Pay Up", "desc": "Lose 15% of your coins. He nails up an official sign.", "req": [], "fx": [["coins_pct", -15], ["build", "sign", 1]], "reply": "Pleasure."},
		"b": {"label": "Hide in the Barn", "desc": "50%: he leaves. 50%: caught, lose 30%.", "req": [], "fx": [["gamble", 0.5, [["mood", 10]], [["coins_pct", -30], ["say", "Caught red-handed..."]]]], "reply": "Hmm."}},
	{"id": "hail", "title": "Hailstorm!", "art": "ic_storm", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["crop", "", 3]],
		"text": "Hailstones the size of turnips. Some of them ARE turnips.",
		"a": {"label": "Cover the Crops", "desc": "Exhausting, but nothing is lost. -50 energy.", "req": [], "fx": [["energy", -50], ["weather", "rain", 90]]},
		"b": {"label": "Hide Inside", "desc": "4 crops flattened in the storm.", "req": [], "fx": [["wither", 4], ["weather", "storm", 40]]}},
	{"id": "boar_tracks", "title": "Boar Tracks", "art": "boar", "rarity": 2, "level": 2, "weird": 0,
		"text": "Huge hoofprints circle the farm. Something big is casing the place.",
		"a": {"label": "Build a Stockade", "desc": "Pay 40. 10 fence posts; no boars for 3 days.", "req": [], "fx": [["coins", -40], ["fence", 10], ["buff", "boar_guard", 1440]]},
		"b": {"label": "Leave Out Turnips", "desc": "Takes 2 ripe turnips. No boars for 3 days.", "req": [], "fx": [["take_ripe", "turnip", 2], ["buff", "boar_guard", 1440]]}},
	{"id": "wishing_well", "title": "Wishing Well", "art": "well", "rarity": 2, "level": 2, "weird": 0,
		"needs": [["obj", "well", 1]],
		"text": "Something glints at the bottom of the well.",
		"a": {"label": "Toss a Coin", "desc": "Pay 20. 40%: the well pays back 250.", "req": [], "fx": [["coins", -20], ["gamble", 0.4, [["coins", 250]], [["mood", 3]]]]},
		"b": {"label": "Climb Down", "desc": "70%: 6 ore. 30%: a nasty fall.", "req": [], "fx": [["gamble", 0.7, [["item", "ore", 6]], [["heal", -25]]]]}},
	{"id": "frog", "title": "The Frog Prince", "art": "v_frog", "rarity": 2, "level": 1, "weird": 3, "visitor": true,
		"text": "A frog in a tiny crown asks for a kiss. 'It's a whole curse thing,' it explains.",
		"a": {"label": "Kiss It", "desc": "30%: a grateful prince pays 600. 70%: frog lips. Poisoned.", "req": [], "fx": [["gamble", 0.3, [["coins", 600], ["log", "A prince! He pays handsomely and leaves."]], [["poison", 20], ["weird", 3]]]], "reply": "Pucker up."},
		"b": {"label": "Give It a Pond", "desc": "A pond for the frog. It croaks gratefully. +1 Charm.", "req": [], "fx": [["pond", 4], ["charm", 1]], "reply": "Ribbit. (Coward.)"}},
	{"id": "rival", "title": "Harvest Race", "art": "v_villager", "rarity": 2, "level": 2, "weird": 0, "visitor": true,
		"text": "A rival farmer challenges you to a harvest race. He's already sweating.",
		"a": {"label": "Accept", "desc": "Needs 5 ripe crops right now. Win 250.", "req": [["ripe", "", 5]], "fx": [["coins", 250], ["mood", 15]], "reply": "Rematch next year!"},
		"b": {"label": "Sabotage Him", "desc": "+100 coins now... but he may get revenge later.", "req": [], "fx": [["coins", 100], ["weird", 1], ["delay", 180, [["spawn", "crow", 5], ["overgrow", 8]], "The rival got his revenge: crows and weeds!"]], "reply": "What was that?"}},
	{"id": "wedding", "title": "A Wedding!", "art": "v_villager", "rarity": 2, "level": 2, "weird": 0, "visitor": true, "crowd": 4,
		"text": "The neighbours are getting married and the florist has run away to sea.",
		"a": {"label": "Sunflower Bouquet", "desc": "Takes 4 growing sunflowers. Paid handsomely.", "req": [], "fx": [["take_crop", "sunflower", 4], ["coins", 260], ["mood", 20]], "reply": "They're perfect!"},
		"b": {"label": "Host It Here", "desc": "Flower beds, a bench and lamps go up. The farm glows.", "req": [], "fx": [["build", "flowerbed", 3], ["build", "bench", 1], ["build", "lamp", 2], ["mood", 25]], "reply": "What a venue!"}},
	{"id": "flute", "title": "Bone Flute", "art": "v_peddler", "rarity": 2, "level": 2, "weird": 5, "visitor": true,
		"needs": [["no_relic", "bone_flute"]],
		"text": "'A flute of bone,' says the peddler. 'Critters hate it. So do neighbours.'",
		"a": {"label": "Buy It", "desc": "Pay 80. Every dawn, all critters flee.", "req": [], "fx": [["coins", -80], ["relic", "bone_flute"], ["weird", 3]], "reply": "Play it softly."},
		"b": {"label": "Haggle", "desc": "40%: it's yours for 25. 60%: he storms off.", "req": [], "fx": [["gamble", 0.4, [["coins", -25], ["relic", "bone_flute"]], [["mood", -5]]]], "reply": "Hmph."}},
	{"id": "aurora", "title": "Aurora", "art": "ic_clear", "rarity": 2, "level": 1, "weird": 5,
		"needs": [["night"]],
		"text": "Green curtains of light ripple across the night sky. They seem to be... beckoning.",
		"a": {"label": "Watch Together", "desc": "Wisps dance over the fields. +30 mood, full energy.", "req": [], "fx": [["spawn", "wisp", 8], ["mood", 30], ["energy", 100]]},
		"b": {"label": "Follow the Lights", "desc": "+4 ore and +6 weird. -30 energy.", "req": [], "fx": [["item", "ore", 4], ["weird", 6], ["energy", -30]]}},
	{"id": "mushroom_ring", "title": "Fairy Ring", "art": "crop_glowshroom", "rarity": 2, "level": 1, "weird": 8,
		"text": "Glowing mushrooms sprout overnight in a perfect circle.",
		"a": {"label": "Cultivate Them", "desc": "Unlock Glowshrooms: a ring-shaped bed of them. +5 weird.", "req": [], "fx": [["unlock", "glowshroom"], ["field", "ring", "glowshroom"], ["weird", 5]]},
		"b": {"label": "Eat One", "desc": "50%: full health & energy. 50%: poisoned and VERY weird.", "req": [], "fx": [["gamble", 0.5, [["energy", 100], ["heal", 50], ["weird", 8]], [["poison", 35], ["weird", 12], ["say", "The colours... I can TASTE them."]]]]}},
	{"id": "cursed_coin", "title": "A Warm Coin", "art": "cursed_coin", "rarity": 2, "level": 2, "weird": 8,
		"needs": [["no_relic", "cursed_coin"]],
		"text": "A coin that is always warm. The farmer threw it away twice. It keeps coming back.",
		"a": {"label": "Keep It", "desc": "Pays out every morning... but sours the farmer's mood.", "req": [], "fx": [["relic", "cursed_coin"], ["weird", 5]]},
		"b": {"label": "Drop It Down the Well", "desc": "Needs a well. -5 weird, +2 Lucky Charms.", "req": [["obj", "well", 1]], "fx": [["weird", -5], ["charm", 2]]}},
	{"id": "giant_turnip", "title": "The Giant Turnip", "art": "crop_turnip", "rarity": 2, "level": 1, "weird": 3,
		"needs": [["crop", "turnip", 1]],
		"text": "One turnip will not stop growing. It is now the size of a dog. A large dog.",
		"a": {"label": "Harvest It Now", "desc": "Takes 1 ripe turnip. Sells for 200.", "req": [], "fx": [["take_ripe", "turnip", 1], ["coins", 200]]},
		"b": {"label": "Let It Grow", "desc": "In 3 minutes: 60% museum money. 40%: boars.", "req": [], "fx": [["delay", 180, [["gamble", 0.6, [["coins", 500], ["log", "The giant turnip sold to a museum!"]], [["spawn", "boar", 2], ["log", "The giant turnip attracted every boar in the county!"]]]], "The giant turnip..."]]}},
	{"id": "homunculus_hungry", "title": "It's Hungry", "art": "v_homunculus", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["relic", "homunculus"]],
		"text": "The homunculus tugs the farmer's sleeve. 'Hungry,' it rasps. 'HUNGRY.'",
		"a": {"label": "Feed It Carrots", "desc": "Takes 2 ripe carrots. It tends the crops: 1.5x growth.", "req": [], "fx": [["take_ripe", "carrot", 2], ["buff", "growth", 600], ["mood", 3]]},
		"b": {"label": "Ignore It", "desc": "50%: it finds its own food. A chicken goes missing.", "req": [], "fx": [["gamble", 0.5, [["weird", 2], ["clear", 6]], [["chicken", -1], ["weird", 4], ["say", "Where did Henrietta go...?"]]]]}},
	{"id": "tome_page", "title": "The Tome Opens", "art": "tome", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["relic", "tome"]],
		"text": "The Fleshy Tome flops open by itself. One page is... damp.",
		"a": {"label": "Read Aloud", "desc": "60%: every crop ripens. 40%: poison and a boar.", "req": [], "fx": [["gamble", 0.6, [["ripen", -1], ["weird", 8]], [["poison", 30], ["spawn", "boar", 1], ["weird", 5]]]]},
		"b": {"label": "Feed It an Egg", "desc": "Takes 1 egg. It purrs. +2 Lucky Charms.", "req": [], "fx": [["item", "egg", -1], ["charm", 2], ["weird", 3]]}},
	# ---- townsfolk & abilities
	{"id": "baker", "title": "The Baker's Cart", "art": "v_villager", "rarity": 2, "level": 1, "weird": 0, "visitor": true,
		"needs": [["no_friend", "betty"], ["day", 2]],
		"text": "Betty the baker's cart rattles up the lane, smelling of cinnamon and ambition.",
		"a": {"label": "Buy Every Pie", "desc": "Pay 40. Betty becomes a friend: pie every morning.", "req": [], "fx": [["coins", -40], ["friend", "betty"], ["energy", 60]], "reply": "See you tomorrow, dear!"},
		"b": {"label": "Trade Eggs", "desc": "Takes 3 eggs. Full health and energy.", "req": [], "fx": [["item", "egg", -3], ["heal", 100], ["energy", 100]], "reply": "Lovely eggs!"}},
	{"id": "smith", "title": "The Blacksmith", "art": "v_villager", "rarity": 2, "level": 2, "weird": 0, "visitor": true,
		"needs": [["no_friend", "smith"]],
		"text": "Old Smith squints at the farmer's tools. 'Who sharpened this? A goat?'",
		"a": {"label": "Befriend Him", "desc": "Smith visits daily: mends buildings, brings stone.", "req": [], "fx": [["friend", "smith"], ["action", "repair"]], "reply": "Hmph. Fine."},
		"b": {"label": "Giant Watering Can", "desc": "Pay 60. Watering now soaks the tiles around too.", "req": [["no_perk", "big_can"]], "fx": [["coins", -60], ["perk", "big_can"]], "reply": "Don't drop it on your foot."}},
	{"id": "mayor", "title": "The Mayor Visits", "art": "v_suit", "rarity": 2, "level": 2, "weird": 0, "visitor": true,
		"needs": [["no_friend", "mayor"], ["fields", 2]],
		"text": "The mayor arrives with a sash, a photographer, and very clean shoes.",
		"a": {"label": "Show Him Around", "desc": "Needs 8 path tiles. The mayor pays a daily subsidy.", "req": [["paths", 8]], "fx": [["friend", "mayor"], ["coins", 100]], "reply": "Splendid paths!"},
		"b": {"label": "Ask for a Grant", "desc": "+150 coins; the council puts up a sign and lamps.", "req": [], "fx": [["coins", 150], ["build", "sign", 1], ["build", "lamp", 2]], "reply": "For the community!"}},
	{"id": "doc", "title": "Doc Hollis", "art": "v_villager", "rarity": 2, "level": 1, "weird": 0, "visitor": true,
		"needs": [["no_friend", "doc"], ["day", 2]],
		"text": "The village doctor is out walking. He takes one look at the farmer and sighs.",
		"a": {"label": "Regular Checkups", "desc": "Pay 50. Doc visits daily; fainting is free.", "req": [], "fx": [["coins", -50], ["friend", "doc"], ["heal", 100], ["cure"]], "reply": "Eat a vegetable."},
		"b": {"label": "Iron Tonic", "desc": "Iron Gut: immune to poison, forever. Tastes of nails.", "req": [["no_perk", "iron_gut"]], "fx": [["perk", "iron_gut"], ["heal", 30]], "reply": "Don't ask what's in it."}},
	{"id": "barn_raising", "title": "Barn Raising", "art": "coop", "rarity": 2, "level": 2, "weird": 0, "visitor": true, "crowd": 5,
		"needs": [["friends", 2]],
		"text": "The whole village turns up with hammers, ladders and three different pies.",
		"a": {"label": "Raise a Coop", "desc": "A coop with hens, plus Carpenter: builds twice as fast.", "req": [], "fx": [["build", "coop", 1], ["chicken", 1], ["perk", "carpenter"]], "reply": "Heave!"},
		"b": {"label": "Dig a Well", "desc": "A well and a stone path to it.", "req": [], "fx": [["build", "well", 1], ["path", 10]], "reply": "Ho!"}},
	{"id": "market_day", "title": "Market Day", "art": "basket", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["stat", "harvested", 10]],
		"text": "The village market is buzzing. The cheese man is shouting about cheese.",
		"a": {"label": "Haggling Lessons", "desc": "Pay 50. Silver Tongue: produce sells for 30% more.", "req": [["no_perk", "haggler"]], "fx": [["coins", -50], ["perk", "haggler"]]},
		"b": {"label": "Sell It All", "desc": "Needs produce. Everything sells at 2.5x.", "req": [["inventory", 1]], "fx": [["sell", 2.5]]}},
	{"id": "rooster", "title": "The Rooster", "art": "chicken", "rarity": 2, "level": 1, "weird": 0,
		"text": "A rooster has moved in. He crows at 4am. And 4:15. And 4:30.",
		"a": {"label": "Keep Him", "desc": "Early Bird: the farmer rests twice as fast. +1 chicken.", "req": [["no_perk", "early_bird"]], "fx": [["perk", "early_bird"], ["chicken", 1]]},
		"b": {"label": "Sunday Roast", "desc": "Full health, +30 mood.", "req": [], "fx": [["heal", 100], ["mood", 30]]}},
	{"id": "running_shoes", "title": "Running Shoes", "art": "v_peddler", "rarity": 2, "level": 1, "weird": 0, "visitor": true,
		"text": "A peddler holds up a pair of very red, very fast-looking boots.",
		"a": {"label": "Buy Them", "desc": "Pay 70. Quick Feet: walks 35% faster.", "req": [["no_perk", "quick_feet"]], "fx": [["coins", -70], ["perk", "quick_feet"]], "reply": "Zoom zoom."},
		"b": {"label": "Trade for Seeds", "desc": "Stripes of carrots, sown at once.", "req": [], "fx": [["field", "stripes", "carrot"]], "reply": "Good trade!"}},
	{"id": "old_soldier", "title": "The Old Soldier", "art": "v_villager", "rarity": 2, "level": 1, "weird": 0, "visitor": true,
		"text": "A grizzled old soldier offers to 'toughen up' the farmer. He is already doing push-ups.",
		"a": {"label": "Boot Camp", "desc": "-60 energy. Tough as Boots: takes half damage.", "req": [["no_perk", "tough"]], "fx": [["energy", -60], ["perk", "tough"]], "reply": "DROP AND GIVE ME TWENTY."},
		"b": {"label": "Help Clear Land", "desc": "He clears 16 patches, then naps on the bench.", "req": [], "fx": [["clear", 16], ["mood", 10]], "reply": "Like the old days."}},
	{"id": "piper", "title": "The Piper", "art": "v_wizard", "rarity": 2, "level": 1, "weird": 6, "visitor": true,
		"text": "A thin man in patchwork plays a tune. Every rabbit for a mile sits up and listens.",
		"a": {"label": "Learn the Tune", "desc": "Pied Piper: critters flee when he's near. +4 weird.", "req": [["no_perk", "pied_piper"]], "fx": [["perk", "pied_piper"], ["weird", 4]], "reply": "Hum it softly."},
		"b": {"label": "Pay Him to Play", "desc": "Pay 30. Every critter leaves; no crows for 2 days.", "req": [], "fx": [["coins", -30], ["action", "shoo"], ["buff", "crow_truce", 960]], "reply": "Toot."}},
	{"id": "regrowth", "title": "It Grew Back", "art": "tallgrass", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["cleared", 45]],
		"text": "One rainy week and the wild is creeping back in from the edges.",
		"a": {"label": "Hire Help", "desc": "Pay 30. 20 patches cleared.", "req": [], "fx": [["coins", -30], ["clear", 20]]},
		"b": {"label": "Let It Be Wild", "desc": "Overgrowth returns, with butterflies and bees. +2 Charms.", "req": [], "fx": [["overgrow", 12], ["spawn", "butterfly", 6], ["charm", 2], ["mood", 10]]}},
	{"id": "orchard", "title": "Orchard Saplings", "art": "tree_apple", "rarity": 2, "level": 2, "weird": 0,
		"text": "The nursery is closing down. Saplings, cheap, must go!",
		"a": {"label": "Plant an Orchard", "desc": "Pay 40. Five apple trees along the edge.", "req": [], "fx": [["coins", -40], ["trees", 5]]},
		"b": {"label": "Firewood", "desc": "+20 wood.", "req": [], "fx": [["item", "wood", 20]]}},
	{"id": "landscaper", "title": "Landscaping", "art": "flowerbed", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["paths", 6]],
		"text": "A landscaper admires the paths. 'Lovely bones,' she says. 'Needs colour.'",
		"a": {"label": "Flowers Everywhere", "desc": "Flower beds along the paths, the farm in bloom.", "req": [], "fx": [["build", "flowerbed", 4], ["action", "bloom"]]},
		"b": {"label": "More Paths", "desc": "12 more tiles of path, all over the farm.", "req": [], "fx": [["path", 12]]}},
	{"id": "silly_plan", "title": "A Brilliant Idea", "art": "farmer_idle", "rarity": 2, "level": 1, "weird": 0,
		"needs": [["fields", 1]],
		"text": "The farmer wakes up with an idea. 'What if,' he says, 'a field... but SMILING?'",
		"a": {"label": "Let Him", "desc": "A smiley-face field, sown with a silly mix of crops.", "req": [], "fx": [["field", "smiley", "mixed"], ["mood", 20]]},
		"b": {"label": "Something Sensible", "desc": "A big tidy block of his fanciest crop.", "req": [], "fx": [["field", "block", ""]]}},
	# ---- the dark totems (prerequisite chain: find one, then the altar cards start showing up)
	{"id": "carved_stump", "title": "The Carved Stump", "art": "totem", "rarity": 2, "level": 1, "weird": 8, "once": true,
		"text": "Clearing an old stump, the farmer finds a pole carved with faces. They look... hungry.",
		"a": {"label": "Stand It Up", "desc": "Dark Totem 1/6. Something answers from under the soil.", "req": [], "fx": [["totem", 1]]},
		"b": {"label": "Burn It", "desc": "It screams a little. -5 weird, +2 Charms.", "req": [], "fx": [["weird", -5], ["charm", 2]]}},
	{"id": "dark_altar", "title": "The Dark Altar", "art": "altar", "rarity": 2, "level": 1, "weird": 10,
		"needs": [["totems", 1]],
		"text": "Blood-red candles light themselves on the altar. It wants something. It is patient. For now.",
		"a": {"label": "Sacrifice a Chicken", "desc": "Gives 1 chicken. Every crop ripens; growth up 10 min.", "req": [], "fx": [["chicken", -1], ["ripen", -1], ["buff", "growth", 600], ["weird", 6]]},
		"b": {"label": "Sacrifice the Harvest", "desc": "Takes 4 ripe crops. Gold pours from the candles.", "req": [], "fx": [["take_ripe", "", 4], ["coins", 400], ["weird", 5]]}},
	{"id": "peddler_totem", "title": "The Peddler Returns", "art": "v_peddler", "rarity": 2, "level": 1, "weird": 12, "visitor": true, "once": true,
