extends RefCounted
class_name Deck
## The deck of choice cards. Pure data — logic lives in cards.gd.
## Cards arrive slowly (one every few minutes, see Settings), so every choice should leave a
## visible mark: a new field, a fence, a path, a building, trees, animals, a townsfolk friend,
## a farmer ability, weather, relics... Avoid "+5 mood" style filler.
##
## Card fields:
##   id, title, art (Art sprite key), text (flavour, ~120 chars max)
##   rarity  1 common · 2 uncommon · 3 rare · 4 legendary · 0 = never drawn (follow-up only)
##   level   min farm level to be drawn        weird  min weirdness to be drawn
##   needs   [requirements] that must ALL hold before the card can ever be drawn (prerequisites)
##   once    true = never drawn again after it has been played
##   visitor true = the art walks onto the farm when you choose   crowd n = n visitors come
##   a / b   choices: {label (<=20 chars), desc (<=80 chars), req: [...], fx: [...], reply: "visitor line"}
##
## Requirements (all must hold; costs in fx are auto-added as requirements):
##   ["crop", type, n] n growing (alive, any stage; type "" = any)   ["ripe", type, n]
##   ["obj", type, n] objects/structures on the farm   ["no_obj", type]   ["relic", id]   ["no_relic", id]
##   ["perk", id]   ["no_perk", id]   ["friend", id]   ["no_friend", id]   ["friends", n]
##   ["totems", n]   ["no_totems", n] (fewer than n)   ["played", card]   ["not_played", card]
##   ["chose", card, "a"|"b"]   ["day", n]   ["cleared", pct]   ["overgrown", pct]   ["fields", n]
##   ["paths", n]   ["pond"]   ["quirk", id]   ["weather", w]   ["night"]   ["day_time"]   ["level", n]
##   ["weird", n]   ["mood", n]   ["health", n]   ["chickens", n]   ["tilled", n]   ["charms", n]
##   ["stat", name, n]   ["inventory", n] (any produce)   ["coins", n]   ["item", id, n]
##
## Effects:
##   ["coins", n] (+ scales with level, - is a cost)   ["coins_pct", pct]   ["item", id, n] (wood/stone too)
##   ["heal", n] (- hurts, Lucky Charms block)   ["energy", n]   ["mood", n]   ["weird", n]
##   ["poison", secs]   ["cure"]   ["charm", n]   ["buff", name, secs]   ["weather", w, secs]
##   ["action", id] (rain shoo dog bloom bees meteor quake tree merchant critters storm clear fert)
##   ["event", id] (crows rabbits fox boar snake wasps weeds butterflies lucky crop_circle)
##   ["spawn", kind, n]   ["grow", amount]   ["ripen", n|-1]   ["wither", n|-1]   ["mutate", n, crop?]
##   ["plant", crop, n]   ["unlock", crop]   ["favor", crop, secs]   ["relic", id]   ["lose_relic", id]
##   ["draw", n]   ["chicken", n]   ["sell", mult]   ["take_ripe", crop, n]   ["take_crop", crop, n]
##   ["water_all"]   ["clear_weeds"]   ["burn", obj_type]   ["add_card", id]   ["say", text]   ["log", text]
##   ["gamble", chance, [fx if lucky], [fx if not]]   ["delay", secs, [fx], "log note"]
##   Farm-shaping: ["clear", n|-1] overgrowth   ["overgrow", n]   ["field", shape, crop|"mixed"|"none", max]
##   ["path", n]   ["fence", n]   ["build", struct, n]   ["demolish", struct]   ["trees", n]   ["pond", size]
##   ["perk", id]   ["lose_perk", id]   ["friend", id]   ["lose_friend", id]   ["totem", n] (- = lose)
## Field shapes: see World.SHAPES ("" = farmer's whim). Perks: Game.PERKS. Friends: Game.FRIENDS.
## Buff names: sun (2x growth), growth (1.5x), dog, bounty, crow_truce, boar_guard, favor
## Time: one in-game day is 480s.

