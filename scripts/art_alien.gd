## Variants built from other sprites (base = Art.SPRITES).
static func variants(_base: Dictionary) -> Dictionary:
	var hatch: Array = []
	for r in SPRITES["a_egg"]:
		hatch.append(String(r).replace("e", "k").replace("2", "b"))
	return {"a_egg_hatching": hatch}
