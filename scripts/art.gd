const GRASS_BASE := Color("5da84a")
const GRASS_DARK := Color("4b9440")
const GRASS_LIGHT := Color("7cc35c")

var _tex := {}
var _font: ImageTexture
var _glyph_index := {}
var _missing: ImageTexture


func _ready() -> void:
	for key in SPRITES:
		_tex[key] = _from_ascii(SPRITES[key])
	var strange: Dictionary = preload("res://scripts/art_strange.gd").SPRITES
	for key in strange:
		_tex[key] = _from_ascii(strange[key])
	var farm: Dictionary = preload("res://scripts/art_farm.gd").SPRITES
	for key in farm:
		_tex[key] = _from_ascii(farm[key])
	var chest_art = preload("res://scripts/art_chest.gd")
	var chest: Dictionary = chest_art.SPRITES.merged(chest_art.variants())
	for key in chest:
		_tex[key] = _from_ascii(chest[key])
	var alien_art = preload("res://scripts/art_alien.gd")
	var alien: Dictionary = alien_art.SPRITES.merged(alien_art.variants(SPRITES))
	for key in alien:
		_tex[key] = _from_ascii(alien[key])
	_tex["ufo"] = _tex["saucer"]   # the landed saucer of the "Lights in the Sky" mystery
	_tex["pine"] = _paint_pine()
	_tex["gear"] = _from_ascii([".7.7.7.", "7777777", ".77.77.", "777.777", ".77.77.", "7777777", ".7.7.7."])
	_paint_ground()
	_tex["house"] = _paint_house()
	_tex["coop"] = _paint_coop()
	_tex["tree"] = _paint_tree(false)
	_tex["tree_apple"] = _paint_tree(true)
	_tex["well"] = _paint_well()
	_build_font()
	var m := Image.create(8, 8, false, Image.FORMAT_RGBA8)
	m.fill(Color.MAGENTA)
	_missing = ImageTexture.create_from_image(m)


func tex(name: String) -> Texture2D:
	return _tex.get(name, _missing)


func has(name: String) -> bool:
	return _tex.has(name)


func col(ch: String) -> Color:
	return PAL.get(ch, Color.MAGENTA)


# ---------------------------------------------------------------- builders
func _from_ascii(rows: Array) -> ImageTexture:
	var h := rows.size()
	var w := 0
	for r in rows:
		w = maxi(w, String(r).length())
	var img := Image.create(maxi(w, 1), maxi(h, 1), false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in h:
		var row: String = rows[y]
		for x in row.length():
			var ch := row[x]
			if ch != "." and PAL.has(ch):
				img.set_pixel(x, y, PAL[ch])
	return ImageTexture.create_from_image(img)


func _img(w: int, h: int) -> Image:
	var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	return img


func _rect(img: Image, x: int, y: int, w: int, h: int, c: Color) -> void:
	for yy in range(maxi(y, 0), mini(y + h, img.get_height())):
		for xx in range(maxi(x, 0), mini(x + w, img.get_width())):
			img.set_pixel(xx, yy, c)


func _px(img: Image, x: int, y: int, c: Color) -> void:
	if x >= 0 and y >= 0 and x < img.get_width() and y < img.get_height():
		img.set_pixel(x, y, c)


func _paint_ground() -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = 1337
	for v in 4:
		var img := _img(16, 16)
		img.fill(GRASS_BASE)
		for i in 14:
			_px(img, rng.randi_range(0, 15), rng.randi_range(0, 15), GRASS_DARK)
		for i in 6:
			var x := rng.randi_range(1, 14)
			var y := rng.randi_range(2, 15)
			_px(img, x, y, GRASS_LIGHT)
			_px(img, x, y - 1, GRASS_LIGHT)
		if v == 3:
			_px(img, 4, 5, col("7"))
			_px(img, 11, 10, col("a"))
			_px(img, 7, 13, col("e"))
		_tex["grass%d" % v] = ImageTexture.create_from_image(img)
	for wet in [false, true]:
		var img := _img(16, 16)
		var base := Color("9a6a45") if not wet else Color("6a4630")
		var dark := Color("7a4e32") if not wet else Color("4f3222")
		var light := Color("b0805a") if not wet else Color("7d5740")
		img.fill(base)
		for y in 16:
			if y % 4 == 1:
				for x in range(1, 15):
					_px(img, x, y, dark)
			elif y % 4 == 0:
				for x in range(1, 15):
					if (x + y) % 5 != 0:
						_px(img, x, y, light)
		for x in 16:
			_px(img, x, 0, dark)
			_px(img, x, 15, dark)
		for y in 16:
			_px(img, 0, y, dark)
			_px(img, 15, y, dark)
		if wet:
			_px(img, 4, 6, Color("8fb8d8"))
			_px(img, 11, 10, Color("8fb8d8"))
		_tex["tilled_wet" if wet else "tilled"] = ImageTexture.create_from_image(img)
	# footpaths: packed dirt with pebbles, two variants
	for v in 2:
		var img := _img(16, 16)
		img.fill(Color("c9a26b"))
		for i in 18:
			_px(img, rng.randi_range(0, 15), rng.randi_range(0, 15), Color("b08850"))
		for i in 6:
			var x := rng.randi_range(1, 13)
			var y := rng.randi_range(1, 13)
			_rect(img, x, y, 2, 1, Color("e0c08a"))
			_px(img, x, y + 1, Color("8a6a40"))
		_tex["path%d" % v] = ImageTexture.create_from_image(img)


func _paint_pine() -> ImageTexture:
	var img := _img(16, 30)
	_rect(img, 7, 24, 2, 6, col("h"))
	for y in range(0, 25):
		var half := 1 + int(y * 0.3) + (2 if y % 6 >= 3 else 0)
		for x in range(8 - half, 8 + half):
			var c := col("m")
			if x == 8 - half or x == 8 + half - 1 or y % 6 == 5:
				c = col("g")
			elif (x + y * 2) % 7 == 0:
				c = col("3")
			_px(img, x, y, c)
	return ImageTexture.create_from_image(img)


func _paint_house() -> ImageTexture:
	var img := _img(32, 32)
	# chimney
	_rect(img, 22, 2, 4, 8, col("5"))
	_rect(img, 22, 2, 4, 1, col("6"))
	# roof (triangle-ish)
	for y in range(3, 15):
		var half := 4 + int((y - 3) * 1.1)
		var x0 := 16 - half
		var x1 := 16 + half
		for x in range(x0, x1):
			var c := col("8")
			if x == x0 or x == x1 - 1:
				c = col("2")
			elif (y % 3) == 0 and (x % 4) != 0:
				c = Color("9a3448")
			_px(img, x, y, c)
	for x in range(2, 30):
		_px(img, x, 15, col("2"))
	# walls
	_rect(img, 4, 16, 24, 15, col("i"))
	for y in range(16, 31, 3):
		for x in range(4, 28):
			_px(img, x, y, col("4"))
	_rect(img, 4, 16, 1, 15, col("4"))
	_rect(img, 27, 16, 1, 15, col("4"))
	# windows
	for wx in [6, 22]:
		_rect(img, wx, 18, 5, 5, col("7"))
		_rect(img, wx + 1, 19, 3, 3, col("c"))
		_px(img, wx + 2, 19, col("k"))
	# door
	_rect(img, 18, 21, 7, 10, col("h"))
	_rect(img, 19, 22, 5, 9, col("4"))
	_px(img, 22, 26, col("a"))
	# step
	_rect(img, 17, 31, 9, 1, col("5"))
	return ImageTexture.create_from_image(img)


func _paint_coop() -> ImageTexture:
	var img := _img(24, 22)
	for y in range(1, 9):
		var half := 3 + int((y - 1) * 1.2)
		for x in range(12 - half, 12 + half):
			_px(img, x, y, col("5") if (y + x) % 5 else col("l"))
	_rect(img, 1, 9, 22, 1, col("l"))
	_rect(img, 2, 10, 20, 11, col("8"))
	for x in range(2, 22, 3):
		_rect(img, x, 10, 1, 11, Color("9a3448"))
	# door with white X frame
	_rect(img, 8, 13, 8, 8, col("7"))
	_rect(img, 9, 14, 6, 7, col("h"))
	for i in 6:
		_px(img, 9 + i, 14 + i, col("7"))
		_px(img, 14 - i, 14 + i, col("7"))
	_rect(img, 3, 12, 3, 3, col("a"))
	_rect(img, 18, 12, 3, 3, col("a"))
	_rect(img, 6, 21, 12, 1, col("4"))
	return ImageTexture.create_from_image(img)


func _paint_tree(apples: bool) -> ImageTexture:
	var img := _img(20, 28)
	_rect(img, 8, 17, 4, 10, col("4"))
	_rect(img, 8, 17, 1, 10, col("h"))
	_rect(img, 6, 26, 8, 2, col("h"))
	var c := Vector2(10, 10)
	for y in 22:
		for x in 20:
			var d := Vector2(x, y).distance_to(c)
			var wob := 8.5 + sin(x * 1.3 + y * 0.7) * 0.8
			if d < wob:
				var cc := col("m")
				if d > wob - 1.2:
					cc = col("g")
				elif (x - 7) * (x - 7) + (y - 6) * (y - 6) < 12:
					cc = col("3")
				if (x * 7 + y * 3) % 11 == 0:
					cc = col("b")
				_px(img, x, y, cc)
	if apples:
		for p in [Vector2i(6, 9), Vector2i(13, 7), Vector2i(11, 13), Vector2i(5, 14), Vector2i(15, 12)]:
			_px(img, p.x, p.y, col("8"))
			_px(img, p.x + 1, p.y, col("8"))
	return ImageTexture.create_from_image(img)


func _paint_well() -> ImageTexture:
	var img := _img(16, 20)
	# roof
	for y in range(0, 5):
		var half := 2 + y * 1.4
		for x in range(int(8 - half), int(8 + half)):
			_px(img, x, y, col("8") if y < 4 else col("2"))
	_rect(img, 3, 5, 1, 8, col("4"))
	_rect(img, 12, 5, 1, 8, col("4"))
	_rect(img, 4, 7, 8, 1, col("h"))
	_rect(img, 7, 8, 2, 3, col("6"))
	# stone ring
	_rect(img, 1, 12, 14, 7, col("5"))
	_rect(img, 2, 12, 12, 2, col("d"))
	for x in range(1, 15, 3):
		_rect(img, x, 15, 2, 1, col("6"))
	for x in range(2, 15, 3):
		_rect(img, x, 17, 2, 1, col("6"))
	_rect(img, 1, 19, 14, 1, col("l"))
	return ImageTexture.create_from_image(img)


# ---------------------------------------------------------------- font
func _build_font() -> void:
	var keys := GLYPHS.keys()
	var img := _img(keys.size() * 4, 5)
	for i in keys.size():
		var rows: Array = GLYPHS[keys[i]]
		_glyph_index[keys[i]] = i
		for y in 5:
			var row: String = rows[y]
			for x in 3:
				if row[x] == "#":
					img.set_pixel(i * 4 + x, y, Color.WHITE)
	_font = ImageTexture.create_from_image(img)


func text_width(s: String) -> int:
	return maxi(0, s.length() * 4 - 1)


## Draws text with the 3x5 pixel font. Lower-case is drawn as upper-case.
func draw_text(ci: CanvasItem, s: String, pos: Vector2, color: Color = Color.WHITE, shadow: Color = Color(0, 0, 0, 0)) -> void:
	var x := floorf(pos.x)
	var y := floorf(pos.y)
	for ch in s.to_upper():
		if _glyph_index.has(ch):
			var src := Rect2(_glyph_index[ch] * 4, 0, 3, 5)
			if shadow.a > 0.0:
				ci.draw_texture_rect_region(_font, Rect2(x + 1, y + 1, 3, 5), src, shadow)
			ci.draw_texture_rect_region(_font, Rect2(x, y, 3, 5), src, color)
		x += 4


## Word-wraps to at most max_chars per line.
func wrap(s: String, max_chars: int) -> PackedStringArray:
	var out := PackedStringArray()
	var line := ""
	for word in s.split(" ", false):
		if line == "":
			line = word
		elif line.length() + 1 + word.length() <= max_chars:
			line += " " + word
		else:
			out.append(line)
			line = word
	if line != "":
		out.append(line)
	return out
