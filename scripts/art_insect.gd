const CASTE_FRAMES := ["i_grub", "i_ant", "i_soldier", "i_locust", "i_spinner", "i_glowfly", "i_queen"]


## "_glow" variants of every caste: raised on the creep, they glow cyan and lime.
static func variants(_base: Dictionary) -> Dictionary:
	var out := {}
	for base in CASTE_FRAMES:
		for n in ["1", "2"]:
			var rows: Array = []
			for r in SPRITES[base + n]:
				rows.append(String(r).replace("h", "g").replace("4", "g").replace("9", "k").replace("j", "b").replace("3", "k").replace("m", "g").replace("2", "d"))
			out[base + n + "_glow"] = rows
	return out
